# ============================================================
# DealScout Agent - Variables de Entorno
# ============================================================
# Copia este archivo como .env y completa los valores
# cp .env.example .env

# --- OBLIGATORIO ---
# Claude API key (Anthropic)
# Obtener en: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- RECOMENDADO (mejora los resultados) ---
# Tavily - busqueda web para agentes IA
# Free tier: 1000 creditos/mes | https://tavily.com/
TAVILY_API_KEY=

# SerpAPI - Google Shopping Chile
# Free tier: 250 busquedas/mes | https://serpapi.com/
SERPAPI_KEY=

# Firecrawl - extraccion estructurada de paginas web
# Desde $16/mes (hobby) | https://firecrawl.dev/
FIRECRAWL_API_KEY=

# --- OBSERVABILIDAD (LangSmith) ---
# Traza todas las llamadas al agente: tokens, tool calls, latencia, steps
# Crear cuenta gratis en: https://smith.langchain.com/
# Free tier: 5000 trazas/mes
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=dealscout-agent
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com  # default, no cambiar

# --- OPCIONAL ---
# MercadoLibre OAuth (busquedas basicas NO lo requieren)
# Solo necesario para datos de vendedor avanzados
# Obtener en: https://developers.mercadolibre.cl/
MERCADOLIBRE_ACCESS_TOKEN=

# Modelo a usar (default: anthropic:claude-sonnet-4-6)
# DEALSCOUT_MODEL=anthropic:claude-sonnet-4-6
